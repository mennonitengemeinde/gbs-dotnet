<MudPaper Class="tw-flex tw-p-4 tw-mb-4">
    <MudSelect Label="Church"
               T="int"
               Variant="Variant.Outlined"
               Value="@ChurchValue"
               ValueChanged="@ChurchValueChanged"
               Margin="Margin.Dense"
               AnchorOrigin="Origin.BottomCenter">
        <MudSelectItem T="int" Value="0">All</MudSelectItem>
        @foreach (var church in Churches)
        {
            <MudSelectItem T="int" Value="@church.Id">@church.Name</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

@code {

    [Parameter] [EditorRequired] public List<ChurchResponse> Churches { get; set; } = new();

    [Parameter] public int ChurchValue { get; set; }

    [Parameter] public EventCallback<int> ChurchValueChanged { get; set; }

}